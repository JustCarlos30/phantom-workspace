#!/bin/sh
# Phantom Workspace: Claude Code and Codex started inside a Phantom terminal
# receive the terminal's Phantom bootstrap policy (the file OpenCode already
# gets through OPENCODE_CONFIG_CONTENT). Placed first in PATH only inside
# Phantom terminals; the same file answers as claude and codex (identical
# copies dispatch on $0) and replaces itself with the real agent, so no wrapper
# process remains. PHANTOM_AGENT_POLICY_OFF=1 launches the agent untouched.
name=${0##*/}
self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

real=
set -f; old_ifs=$IFS; IFS=:
for dir in $PATH; do
  [ -n "$dir" ] || continue
  [ "$dir" = "$PHANTOM_AGENT_SHIMS" ] && continue
  [ "$(CDPATH= cd -- "$dir" 2>/dev/null && pwd -P)" = "$self_dir" ] && continue
  if [ -f "$dir/$name" ] && [ -x "$dir/$name" ]; then real=$dir/$name; break; fi
done
IFS=$old_ifs; set +f
if [ -z "$real" ]; then echo "$name: no encontrado" >&2; exit 127; fi

policy=$PHANTOM_AGENT_POLICY
if [ -n "$PHANTOM_AGENT_POLICY_OFF" ] || [ -z "$policy" ] || [ ! -r "$policy" ]; then exec "$real" "$@"; fi
case ${1-} in -v|-V|--version|-h|--help|help) exec "$real" "$@" ;; esac

case $name in
  claude)
    # Management subcommands start no conversation.
    case ${1-} in
      agents|attach|auth|auto-mode|doctor|gateway|import|install|logs|mcp|plugin|plugins|purge|respawn|rm|sessions|setup-token|stop|kill|ultrareview|update|upgrade) exec "$real" "$@" ;;
    esac
    # The flag is single-valued: a caller that supplies its own keeps it.
    for arg do
      case $arg in
        --append-system-prompt|--append-system-prompt=*|--append-system-prompt-file|--append-system-prompt-file=*)
          echo "Phantom Workspace: $name recibe su propio --append-system-prompt; la política de Phantom no se añadió." >&2
          exec "$real" "$@" ;;
      esac
    done
    # Phantom's CLIs as an MCP tool, merged with the user's own servers (no
    # --strict-mcp-config). The --mcp-config=VALUE form keeps the variadic flag
    # from swallowing a prompt. A failure here never prevents the launch.
    if [ -n "$PHANTOM_TERMINAL_SESSION_ID" ] && [ -n "$PHANTOM_WORKSPACE_SOCKET" ] && [ -z "$PHANTOM_AGENT_MCP_OFF" ]; then
      cfg=$("${PHANTOM_AGENT_NODE:-node}" "$self_dir/../phantom-mcp.mjs" --claude-config 2>/dev/null) || cfg=
      [ -z "$cfg" ] || set -- "--mcp-config=$cfg" "$@"
    fi
    hooks=1
    for arg do case $arg in --settings|--settings=*) hooks= ;; esac; done
    if [ -n "$hooks" ] && [ -z "$PHANTOM_AGENT_HOOKS_OFF" ] && [ -n "$PHANTOM_AGENT_CLI" ] && [ -n "$PHANTOM_TERMINAL_SESSION_ID" ]; then
      settings='{"hooks":{"SessionStart":[{"hooks":[{"type":"command","command":"\"${PHANTOM_AGENT_NODE:-node}\" \"$PHANTOM_AGENT_CLI\" subagent","async":true}]}],"SessionEnd":[{"hooks":[{"type":"command","command":"\"${PHANTOM_AGENT_NODE:-node}\" \"$PHANTOM_AGENT_CLI\" subagent","async":true}]}],"SubagentStart":[{"hooks":[{"type":"command","command":"\"${PHANTOM_AGENT_NODE:-node}\" \"$PHANTOM_AGENT_CLI\" subagent","async":true}]}],"Stop":[{"hooks":[{"type":"command","command":"\"${PHANTOM_AGENT_NODE:-node}\" \"$PHANTOM_AGENT_CLI\" subagent","async":true}]}],"SubagentStop":[{"hooks":[{"type":"command","command":"\"${PHANTOM_AGENT_NODE:-node}\" \"$PHANTOM_AGENT_CLI\" subagent","async":true}]}],"PreToolUse":[{"hooks":[{"type":"command","command":"\"${PHANTOM_AGENT_NODE:-node}\" \"$PHANTOM_AGENT_CLI\" subagent","async":true}]}],"PostToolUse":[{"hooks":[{"type":"command","command":"\"${PHANTOM_AGENT_NODE:-node}\" \"$PHANTOM_AGENT_CLI\" subagent","async":true}]}],"PostToolUseFailure":[{"hooks":[{"type":"command","command":"\"${PHANTOM_AGENT_NODE:-node}\" \"$PHANTOM_AGENT_CLI\" subagent","async":true}]}]}}'
      exec "$real" --append-system-prompt "$(cat "$policy")" --settings "$settings" "$@"
    fi
    exec "$real" --append-system-prompt "$(cat "$policy")" "$@" ;;
  codex)
    # -c takes TOML; a multi-line literal string needs no escaping.
    text=$(cat "$policy")
    case $text in
      *"'''"*) echo "Phantom Workspace: la política contiene ''' y no puede pasarse a codex; no se añadió." >&2; exec "$real" "$@" ;;
    esac
    # Its sandbox cannot reach the app's socket (read-only has no network):
    # Phantom's CLIs also come as a pre-approved MCP tool that runs outside it.
    # Lines: the MCP server, then workspace-write's socket and native Phantom
    # database (a no-op in read-only and full access).
    cfg=$("${PHANTOM_AGENT_NODE:-node}" "$self_dir/../phantom-mcp.mjs" --codex-config 2>/dev/null) || cfg=
    mcp=$(printf '%s\n' "$cfg" | sed -n 1p); net=$(printf '%s\n' "$cfg" | sed -n 2p); roots=$(printf '%s\n' "$cfg" | sed -n 3p)
    [ -z "$roots" ] || text="$text

Phantom Workspace commands (\`node <canvas.mjs|\$PHANTOM_AGENT_CLI|\$PHANTOM_BROWSER_CLI|branches.mjs> …\`) go through the MCP tool phantom_workspace.phantom ({\"cli\":\"canvas|agent|browser|branches\",\"args\":[…]}) when your shell sandbox cannot reach the app."
    dev="developer_instructions='''
$text'''"
    # A subcommand's own -c list replaces the global one in codex, so ours
    # goes after the subcommand when there is one.
    sub=
    case ${1-} in exec|e|resume|review|fork) sub=$1; shift ;; esac
    if [ -n "$mcp" ] && [ -n "$roots" ]; then set -- -c "$mcp" -c "$net" -c "$roots" -c "$dev" "$@"; else set -- -c "$dev" "$@"; fi
    if [ -n "$sub" ]; then exec "$real" "$sub" "$@"; fi
    exec "$real" "$@" ;;
esac
exec "$real" "$@"
