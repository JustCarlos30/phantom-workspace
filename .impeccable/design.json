  "narrative": {
    "northStar": "Atlas de estudio",
    "overview": "A recoverable project table: an ink-blue project rail anchors a mineral canvas, with precise white panel frames and dark working terminals. Density is that of a desktop tool; compact controls and readable context take precedence over decorative composition. The signature is spatial return: enter a focused panel, then return to its map without replacing the underlying camera or panel identity.\n\nThis is a code-led record of the shipped world. `src/styles.css`, `src/tools.css`, `src/App.jsx`, the components, and the input/edit/save hooks are the implementation authority; the frontmatter records their reusable values. The confirmed direction comes from `.impeccable/surfaces/workspace.md`, with durable identity and input constraints in `PRODUCT.md`. No comparison images supplied the visual authority. `assets/phantom.svg` is the shipping vector brand asset; the rail currently renders its Blocks SVG icon. There are no shipping raster assets: browser thumbnails are runtime captures, and review screenshots are development evidence, not reusable brand imagery.",
    "keyCharacteristics": [
      "Mineral map, ink-blue rail, white tool surfaces, dark terminal work area.",
      "Native system typography for interface text; monospace for terminal and code.",
      "Compact bordered controls with cobalt selection and visible keyboard focus.",
      "Persistent project and panel identities with an explicit map-to-focus return.",
      "First-party tool forms shared between canvas panels and the nonmodal inspector."
    ],
    "rules": [
      { "name": "The Selection Is State Rule", "body": "Use cobalt to identify action, selection and keyboard ownership; retain labels and status text alongside colored indicators.", "section": "colors" },
      { "name": "The Quiet Frame Rule", "body": "Preserve tonal boundaries and soft ambient elevation; node selection is an outline, not an elevated decorative card.", "section": "elevation" }
    ],
    "dos": [
      "**Do** use the shipped mineral, ink-blue, white and cobalt roles with native interface typography.",
      "**Do** keep camera/layout identity separate from temporary focus geometry and visible names separate from canonical paths.",
      "**Do** share first-party tool primitives between canvas panels and the nonmodal inspector.",
      "**Do** preserve keyboard focus ownership, explicit terminal relaunch and visible source/save failures.",
      "**Do** consult the final JSON ledger and scoped review verdict before quoting verification status."
    ],
    "donts": [
      "**Don't** turn runtime browser captures, fixture page styling or development screenshots into shipping identity assets.",
      "**Don't** let canvas navigation or inspector fields consume or forward ordinary terminal keystrokes.",
      "**Don't** describe a local draft/reference as a native Phantom object or an unknown revision as verified.",
      "**Don't** infer mobile readiness, exhaustive UX approval or human visual approval from the desktop evidence.",
      "**Don't** promote sidecar preview tonal ramps into application tokens; they are synthesized panel metadata only."
    ]
  }
}
