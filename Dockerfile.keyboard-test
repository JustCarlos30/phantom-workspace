FROM node:24-bookworm
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb xauth dbus-x11 libgtk-3-0 libnss3 libatk-bridge2.0-0 libdrm2 \
    libgbm1 libasound2 libxss1 libxshmfence1 libx11-xcb1 fonts-dejavu-core \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build
RUN chown root:root node_modules/electron/dist/chrome-sandbox \
    && chmod 4755 node_modules/electron/dist/chrome-sandbox \
    && mkdir -p /tmp/phantom-keyboard-e2e \
    && chmod 1777 /tmp/phantom-keyboard-e2e
ENV PHANTOM_KEYBOARD_EVIDENCE=/tmp/phantom-keyboard-e2e
CMD ["node", "-e", "require('node:fs').chmodSync('/tmp/phantom-keyboard-e2e', 0o1777); process.setgid('node'); process.setuid('node'); process.env.HOME='/tmp'; const child=require('node:child_process').spawn('dbus-run-session',['--','xvfb-run','-a','-s','-screen 0 1600x1000x24','node','test/keyboard-navigation.mjs'],{stdio:'inherit'}); child.on('error',error=>{console.error(error);process.exit(1)}); child.on('exit',code=>process.exit(code??1)); process.on('SIGTERM',()=>child.kill('SIGTERM')); process.on('SIGINT',()=>child.kill('SIGINT'));"]
