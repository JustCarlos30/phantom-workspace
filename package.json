{
  "name": "phantom-workspace",
  "productName": "Phantom Workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workspace espacial local para terminales, agentes y contexto Phantom",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006",
    "build-storybook": "storybook build",
    "test:storybook": "node test/storybook-smoke.mjs",
    "inventory:storybook": "node scripts/storybook-inventory.mjs",
    "start": "electron .",
    "test": "node --test test/*.test.mjs src/hooks/*.test.mjs",
    "bench:core": "node test/perf-core.mjs",
    "test:desktop": "node test/desktop-smoke.mjs",
    "setup:voice": "node scripts/setup-voice.mjs",
    "package": "node scripts/package.mjs",
    "build:latest": "node scripts/build-latest.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^0.577.0",
    "node-pty": "1.1.0",
    "playwright": "^1.58.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "electron": "45.3.0",
    "storybook": "10.6.7",
    "typescript": "7.0.2",
    "vite": "^7.3.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  }
}
